theory HiBaF_v2_fsmin
begin

/* Minimal forward-secrecy model of the HiBaF v2 ratchet (unbounded chain).
   Only the parts that touch measurement secrecy are kept: enrolment key, ratchet advance with
   erasure, state corruption (only of non-erased states), and the sensor's encrypted report.
   Back-end ingestion outputs nothing and signatures do not protect secrecy, so both are omitted. */

builtins: symmetric-encryption, hashing

rule Enrolled:
  [ Fr(~K0) ] --[ St($S, ~K0) ]-> [ S_st($S, ~K0), !SState($S, ~K0) ]

rule S_advance:
  [ S_st($S, K) ] --[ EraseS($S, K), St($S, h(<'next', K>)) ]->
  [ S_st($S, h(<'next', K>)), !SState($S, h(<'next', K>)) ]

rule Corrupt_S_state:
  [ !SState($S, K) ] --[ CorruptS($S, K) ]-> [ Out(K) ]

/* reports read the persistent state record; the restriction 'no_use_after_erasure' forbids
   using a state after it was erased (avoids self-looping linear state facts) */
rule S_report:
  [ !SState($S, K), In(<w, rho>), Fr(~m), Fr(~nu) ]
  --[ Secret($S, ~m, K), UseS($S, K) ]->
  [ Out(<$S, w, ~nu, senc(<~m, <$S, w, rho, ~nu>>, h(<'enc', K, $S, w, rho>))>) ]

restriction erasure_S: "All S K #r #e. CorruptS(S, K)@r & EraseS(S, K)@e ==> #r < #e"
restriction no_use_after_erasure: "All S K #u #e. UseS(S, K)@u & EraseS(S, K)@e ==> #u < #e"

/* Every known state was obtained from a corruption of a state of the same sensor that
   happened before this state was erased (induction over the hash chain). */
lemma state_secrecy [reuse, use_induction]:
  "All S K #i #j. St(S, K)@i & K(K)@j ==>
     Ex K2 #r. CorruptS(S, K2)@r & not (Ex #e. EraseS(S, K)@e & #e < #r)"

lemma measurement_forward_secrecy:
  "All S m K #i #j. Secret(S, m, K)@i & K(m)@j ==>
     Ex K2 #r. CorruptS(S, K2)@r & not (Ex #e. EraseS(S, K)@e & #e < #r)"

/* sanity: corrupting after erasure is possible, and the adversary then learns later states */
lemma corrupt_after_erasure_possible:
  exists-trace
  "Ex S K K2 #e #r. EraseS(S, K)@e & CorruptS(S, K2)@r & #e < #r"

end
