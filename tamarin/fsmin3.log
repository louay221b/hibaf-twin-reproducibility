theory HiBaF_v2_fsmin3 begin

// Function signature and definition of the equational theory E

functions: fst/1, h/1, pair/2, sdec/2, senc/2, snd/1
equations:
    fst(<x.1, x.2>) = x.1,
    sdec(senc(x.1, x.2), x.2) = x.1,
    snd(<x.1, x.2>) = x.2









rule (modulo E) Enrolled:
   [ Fr( ~K0 ) ]
  --[ St( $S, ~K0 ) ]->
   [ S_st( $S, 'e0', ~K0 ), !SState( $S, ~K0 ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) S_advance_01:
   [ S_st( $S, 'e0', K ) ]
  --[ EraseS( $S, K ), St( $S, h(<'next', K>) ) ]->
   [ S_st( $S, 'e1', h(<'next', K>) ), !SState( $S, h(<'next', K>) ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) S_advance_12:
   [ S_st( $S, 'e1', K ) ]
  --[ EraseS( $S, K ), St( $S, h(<'next', K>) ) ]->
   [ S_st( $S, 'e2', h(<'next', K>) ), !SState( $S, h(<'next', K>) ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Corrupt_S_state:
   [ !SState( $S, K ) ] --[ CorruptS( $S, K ) ]-> [ Out( K ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) S_report:
   [ !SState( $S, K ), In( <w, rho> ), Fr( ~m ), Fr( ~nu ) ]
  --[ Secret( $S, ~m, K ), UseS( $S, K ) ]->
   [
   Out( <$S, w, ~nu, senc(<~m, $S, w, rho, ~nu>, h(<'enc', K, $S, w, rho>))>
   )
   ]

  /* has exactly the trivial AC variant */

restriction erasure_S:
  "∀ S K #r #e.
    ((CorruptS( S, K ) @ #r) ∧ (EraseS( S, K ) @ #e)) ⇒ (#r < #e)"
  // safety formula

restriction no_use_after_erasure:
  "∀ S K #u #e. ((UseS( S, K ) @ #u) ∧ (EraseS( S, K ) @ #e)) ⇒ (#u < #e)"
  // safety formula

lemma measurement_forward_secrecy:
  all-traces
  "∀ S m K #i #j.
    ((Secret( S, m, K ) @ #i) ∧ (K( m ) @ #j)) ⇒
    (∃ K2 #r.
      (CorruptS( S, K2 ) @ #r) ∧ (¬(∃ #e. (EraseS( S, K ) @ #e) ∧ (#e < #r))))"
/*
guarded formula characterizing all counter-examples:
"∃ S m K #i #j.
  (Secret( S, m, K ) @ #i) ∧ (K( m ) @ #j)
 ∧
  ∀ K2 #r.
   (CorruptS( S, K2 ) @ #r) ⇒ ∃ #e. (EraseS( S, K ) @ #e) ∧ #e < #r"
*/
simplify
solve( !SState( $S, K ) ▶₀ #i )
  case Enrolled
  solve( !KU( ~m ) @ #vk.3 )
    case S_report
    solve( !KU( h(<'enc', ~K0, $S, w, rho>) ) @ #vk.4 )
      case c_h
      solve( !KU( ~K0 ) @ #vk.9 )
        case Corrupt_S_state
        by contradiction /* cyclic */
      qed
    qed
  qed
next
  case S_advance_01
  solve( !KU( ~m ) @ #vk.3 )
    case S_report
    solve( !KU( h(<'enc', h(<'next', ~K0>), $S, w, rho>) ) @ #vk.4 )
      case c_h
      solve( !KU( h(<'next', ~K0>) ) @ #vk.9 )
        case Corrupt_S_state
        by contradiction /* cyclic */
      next
        case c_h
        solve( !KU( ~K0 ) @ #vk.13 )
          case Corrupt_S_state
          by contradiction /* cyclic */
        qed
      qed
    qed
  qed
next
  case S_advance_12
  solve( !KU( ~m ) @ #vk.3 )
    case S_report
    solve( !KU( h(<'enc', h(<'next', h(<'next', ~K0>)>), $S, w, rho>)
           ) @ #vk.4 )
      case c_h
      solve( !KU( h(<'next', h(<'next', ~K0>)>) ) @ #vk.9 )
        case Corrupt_S_state
        by contradiction /* cyclic */
      next
        case c_h
        solve( !KU( h(<'next', ~K0>) ) @ #vk.13 )
          case Corrupt_S_state
          by contradiction /* cyclic */
        next
          case c_h
          solve( !KU( ~K0 ) @ #vk.15 )
            case Corrupt_S_state
            by contradiction /* cyclic */
          qed
        qed
      qed
    qed
  qed
qed

lemma corrupt_after_erasure_possible:
  exists-trace
  "∃ S K K2 #e #r.
    ((EraseS( S, K ) @ #e) ∧ (CorruptS( S, K2 ) @ #r)) ∧ (#e < #r)"
/*
guarded formula characterizing all satisfying traces:
"∃ S K K2 #e #r.
  (EraseS( S, K ) @ #e) ∧ (CorruptS( S, K2 ) @ #r) ∧ #e < #r"
*/
simplify
solve( !SState( $S, K2 ) ▶₀ #r )
  case Enrolled
  solve( EraseS( $S, K ) @ #e )
    case S_advance_01
    solve( S_st( $S, 'e0', K ) ▶₀ #e )
      case Enrolled
      SOLVED // trace found
    qed
  qed
qed

