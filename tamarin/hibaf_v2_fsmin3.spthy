theory HiBaF_v2_fsmin3
begin

/* Forward secrecy of the HiBaF v2 ratchet on a BOUNDED chain of three epochs (e0 -> e1 -> e2).
   Same rules as hibaf_v2_fsmin.spthy, but the epoch label makes the chain finite so that no
   induction is needed. Reports read the persistent state record and may not use erased states. */

builtins: symmetric-encryption, hashing

rule Enrolled:
  [ Fr(~K0) ] --[ St($S, ~K0) ]-> [ S_st($S, 'e0', ~K0), !SState($S, ~K0) ]

rule S_advance_01:
  [ S_st($S, 'e0', K) ] --[ EraseS($S, K), St($S, h(<'next', K>)) ]->
  [ S_st($S, 'e1', h(<'next', K>)), !SState($S, h(<'next', K>)) ]
rule S_advance_12:
  [ S_st($S, 'e1', K) ] --[ EraseS($S, K), St($S, h(<'next', K>)) ]->
  [ S_st($S, 'e2', h(<'next', K>)), !SState($S, h(<'next', K>)) ]

rule Corrupt_S_state:
  [ !SState($S, K) ] --[ CorruptS($S, K) ]-> [ Out(K) ]

rule S_report:
  [ !SState($S, K), In(<w, rho>), Fr(~m), Fr(~nu) ]
  --[ Secret($S, ~m, K), UseS($S, K) ]->
  [ Out(<$S, w, ~nu, senc(<~m, <$S, w, rho, ~nu>>, h(<'enc', K, $S, w, rho>))>) ]

restriction erasure_S: "All S K #r #e. CorruptS(S, K)@r & EraseS(S, K)@e ==> #r < #e"
restriction no_use_after_erasure: "All S K #u #e. UseS(S, K)@u & EraseS(S, K)@e ==> #u < #e"

lemma measurement_forward_secrecy:
  "All S m K #i #j. Secret(S, m, K)@i & K(m)@j ==>
     Ex K2 #r. CorruptS(S, K2)@r & not (Ex #e. EraseS(S, K)@e & #e < #r)"

/* the attack the lemma rules out is not vacuous: corruption after erasure can happen */
lemma corrupt_after_erasure_possible:
  exists-trace
  "Ex S K K2 #e #r. EraseS(S, K)@e & CorruptS(S, K2)@r & #e < #r"

/* and corruption BEFORE erasure does reveal the measurement (secrecy is tight) */
lemma corruption_before_erasure_reveals:
  exists-trace
  "Ex S m K #i #j #r. Secret(S, m, K)@i & K(m)@j & CorruptS(S, K)@r"

end
