restriction equality:
  "∀ a b #i. (Eq( a, b ) @ #i) ⇒ (a = b)"
  // safety formula

restriction inequality:
  "∀ a b #i. (Neq( a, b ) @ #i) ⇒ (¬(a = b))"
  // safety formula

restriction one_registration_per_identity:
  "∀ S #i #j. ((Setup( S ) @ #i) ∧ (Setup( S ) @ #j)) ⇒ (#i = #j)"
  // safety formula

lemma revocation_possible:
  exists-trace "∃ S #i. Revoke( S ) @ #i"
/*
guarded formula characterizing all satisfying traces:
"∃ S #i. (Revoke( S ) @ #i)"
*/
simplify
solve( !Key( $S, k ) ▶₀ #i )
