theory HiBaF_revocation_fixed begin

// Function signature and definition of the equational theory E

functions: fst/1, h/1, pair/2, pk/1, sdec/2, senc/2, sign/2, snd/1,
           true/0, verify/3
equations:
    fst(<x.1, x.2>) = x.1,
    sdec(senc(x.1, x.2), x.2) = x.1,
    snd(<x.1, x.2>) = x.2,
    verify(sign(x.1, x.2), x.1, pk(x.2)) = true











rule (modulo E) Setup:
   [ Fr( ~k ), Fr( ~x ) ]
  --[ Setup( $S ) ]->
   [ !Key( $S, ~k ), !Ltk( $S, ~x ), !Pk( $S, pk(~x) ), Out( pk(~x) ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Reveal_key:
   [ !Key( $S, k ) ] --[ CorruptK( $S ) ]-> [ Out( k ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Reveal_sig_key:
   [ !Ltk( $S, x ) ] --[ CorruptX( $S ) ]-> [ Out( x ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Honest_report:
   [ !Key( $S, ~k ), !Ltk( $S, ~x ), Fr( ~m ), Fr( ~n ) ]
  --[ Report( $S, ~n ) ]->
   [
   Out( <$S, ~n, senc(~m, ~k), sign(<$S, ~n, senc(~m, ~k)>, ~x), 
         h(<~k, ~n, senc(~m, ~k), sign(<$S, ~n, senc(~m, ~k)>, ~x)>)>
   )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) DT_evidence_check:
   [ !Key( $S, k ), !Pk( $S, pkS ), In( <$S, n, C, sig, T> ) ]
  --[
  Eq( T, h(<k, n, C, sig>) ), Neq( verify(sig, <$S, n, C>, pkS), true ),
  Revoke( $S )
  ]->
   [ ]

  /*
