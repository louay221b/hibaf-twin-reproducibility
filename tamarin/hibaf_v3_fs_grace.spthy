theory HiBaF_v3_fs_grace
begin

/* Forward secrecy of the HiBaF ratchet WITH grace-period retention (response to review 5).
   Bounded chain of three epochs e0 -> e1 -> e2; each epoch has two windows, 'wa' (any window
   except the last) and 'wl' (the last window cE-1 of the epoch).
   On the advance from epoch c to c+1 the holder (the back end; the sensor rules are identical)
   erases K^(c) but retains the window key k = H(enc, K^(c), S, 'wl') of the last window of epoch c
   until the grace period ends (rule Grace_end). Corruption reveals the current state record
   and every retained window key that has not yet been erased.
   Report types tau are folded into the window label (one retained key per type in the
   implementation; the symbolic argument is identical for each type). */

builtins: symmetric-encryption, hashing

rule Enrolled:
  [ Fr(~K0) ] --[ St($S, ~K0) ]-> [ S_st($S, 'e0', ~K0), !SState($S, ~K0) ]

rule Advance_01:
  let kl = h(<'enc', K, $S, 'wl'>) in
  [ S_st($S, 'e0', K) ]
  --[ EraseS($S, K), St($S, h(<'next', K>)), Retain($S, kl) ]->
  [ S_st($S, 'e1', h(<'next', K>)), !SState($S, h(<'next', K>)), R_tok($S, kl), !RKey($S, kl) ]

rule Advance_12:
  let kl = h(<'enc', K, $S, 'wl'>) in
  [ S_st($S, 'e1', K) ]
  --[ EraseS($S, K), St($S, h(<'next', K>)), Retain($S, kl) ]->
  [ S_st($S, 'e2', h(<'next', K>)), !SState($S, h(<'next', K>)), R_tok($S, kl), !RKey($S, kl) ]

rule Grace_end:
  [ R_tok($S, kl) ] --[ EraseR($S, kl) ]-> [ ]

rule Corrupt_state:
  [ !SState($S, K) ] --[ CorruptS($S, K) ]-> [ Out(K) ]

rule Corrupt_retained:
  [ !RKey($S, kl) ] --[ CorruptR($S, kl) ]-> [ Out(kl) ]

rule Report_a:
  [ !SState($S, K), Fr(~m), Fr(~nu) ]
  --[ Secret($S, ~m, K, 'wa'), UseS($S, K) ]->
  [ Out(<$S, 'wa', ~nu, senc(<~m, ~nu>, h(<'enc', K, $S, 'wa'>))>) ]

rule Report_l:
  [ !SState($S, K), Fr(~m), Fr(~nu) ]
  --[ Secret($S, ~m, K, 'wl'), UseS($S, K) ]->
  [ Out(<$S, 'wl', ~nu, senc(<~m, ~nu>, h(<'enc', K, $S, 'wl'>))>) ]

restriction erasure_state: "All S K #r #e. CorruptS(S, K)@r & EraseS(S, K)@e ==> #r < #e"
restriction erasure_retained: "All S k #r #e. CorruptR(S, k)@r & EraseR(S, k)@e ==> #r < #e"
restriction no_use_after_erasure: "All S K #u #e. UseS(S, K)@u & EraseS(S, K)@e ==> #u < #e"

/* A measurement is learned only if (a) the state of its epoch was corrupted before it was
   erased (corruption in that epoch or earlier), or (b) it was sent in the LAST window of its
   epoch and the retained key of that window was corrupted during the grace period. */
lemma forward_secrecy_with_grace:
  "All S m K w #i #j. Secret(S, m, K, w)@i & K(m)@j ==>
     (Ex K2 #r. CorruptS(S, K2)@r & not (Ex #e. EraseS(S, K)@e & #e < #r))
   | (w = 'wl' & (Ex #r. CorruptR(S, h(<'enc', K, S, 'wl'>))@r))"

/* Windows other than the last of an erased epoch stay secret even with grace corruption. */
lemma non_last_windows_secret:
  "All S m K #i #j. Secret(S, m, K, 'wa')@i & K(m)@j ==>
     (Ex K2 #r. CorruptS(S, K2)@r & not (Ex #e. EraseS(S, K)@e & #e < #r))"

/* The grace exception is real: a last-window measurement of an erased epoch can leak when the
   holder is corrupted during the grace period, with no state of that epoch corrupted. */
lemma grace_exposure_possible:
  exists-trace
  "Ex S m K #i #j #e #r. Secret(S, m, K, 'wl')@i & K(m)@j & EraseS(S, K)@e
     & CorruptR(S, h(<'enc', K, S, 'wl'>))@r & #e < #r
     & not (Ex K2 #c. CorruptS(S, K2)@c)"

/* After the grace period ends, corruption no longer reveals the last window either. */
lemma after_grace_secret:
  "All S m K #i #j #g. Secret(S, m, K, 'wl')@i & K(m)@j
     & EraseR(S, h(<'enc', K, S, 'wl'>))@g ==>
     (Ex K2 #r. CorruptS(S, K2)@r & not (Ex #e. EraseS(S, K)@e & #e < #r))
   | (Ex #r. CorruptR(S, h(<'enc', K, S, 'wl'>))@r & #r < #g)"

end
