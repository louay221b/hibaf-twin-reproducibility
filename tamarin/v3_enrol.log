rule (modulo E) BE_4:
   [
   BE_wait3( $S, $BE, X, Y, Km, K0 ), In( <'e3', $S, $BE, sigS, tS> ),
   !Pk( $S, pkS )
   ]
  --[
  Eq( verify(sigS, <'e3', $S, $BE, X, Y>, pkS), true ),
  Eq( tS, mac(Km, <'e3', $S>) ), BECommit( $BE, $S, K0 ),
  BEKey( $BE, $S, K0 )
  ]->
   [ ]

  /*
  rule (modulo AC) BE_4:
     [
     BE_wait3( $S, $BE, X, Y, Km, K0 ), In( <'e3', $S, $BE, sigS, tS> ),
     !Pk( $S, pkS )
     ]
    --[
    Eq( z, true ), Eq( tS, mac(Km, <'e3', $S>) ), BECommit( $BE, $S, K0 ),
    BEKey( $BE, $S, K0 )
    ]->
     [ ]
    variants (modulo AC)
    1. $BE   = $BE.13
       $S    = $S.14
       X     = X.17
       Y     = Y.18
       pkS   = pkS.19
       sigS  = sigS.20
       z     = verify(sigS.20, <'e3', $S.14, $BE.13, X.17, Y.18>, pkS.19)
    
    2. $BE   = $BE.19
       $S    = $S.20
       X     = X.23
       Y     = Y.24
       pkS   = pk(x.36)
       sigS  = sign(<'e3', $S.20, $BE.19, X.23, Y.24>, x.36)
       z     = true
  */

restriction equality:
  "∀ x y #i. (Eq( x, y ) @ #i) ⇒ (x = y)"
  // safety formula

lemma executable:
  exists-trace
  "∃ S BE K #i #j.
    (((SCommit( S, BE, K ) @ #i) ∧ (BECommit( BE, S, K ) @ #j)) ∧
     (#i < #j)) ∧
    (¬(∃ A #r. RevLtk( A ) @ #r))"
/*
guarded formula characterizing all satisfying traces:
"∃ S BE K #i #j.
  (SCommit( S, BE, K ) @ #i) ∧ (BECommit( BE, S, K ) @ #j)
 ∧
  (#i < #j) ∧ (∀ A #r. (RevLtk( A ) @ #r) ⇒ ⊥)"
*/
simplify
solve( S_wait1( $S, $BE, ~a ) ▶₀ #i )
  case S_1
  solve( !Pk( $BE, pk(x) ) ▶₂ #i )
    case Register_pk
    solve( !Ltk( $S, skS ) ▶₃ #i )
      case Register_pk
      solve( BE_wait3( $S, $BE, X, Y.1, Km, h(<'enrol', z, $S, $BE, 'g'^~a, Y>)
             ) ▶₀ #j )
        case BE_2
        solve( !Pk( $S, pk(x) ) ▶₂ #j )
          case Register_pk
          solve( !KU( sign(<'e2', $S, $BE, 'g'^~a, 'g'^~b>, ~sk) ) @ #vk.15 )
            case BE_2
            solve( !KU( sign(<'e3', $S, $BE, 'g'^~a, 'g'^~b>, ~sk.2) ) @ #vk.19 )
              case S_3
              solve( !KU( sign(<'e1', $S, $BE, 'g'^~a>, ~sk.3) ) @ #vk.24 )
                case S_1
                solve( !KU( mac(h(<'mac', 'g'^(~a*~b), $S, $BE, 'g'^~a, 'g'^~b>),
                                <'e2', $BE>)
                       ) @ #vk.19 )
                  case BE_2
                  solve( !KU( mac(h(<'mac', 'g'^(~a*~b), $S, $BE, 'g'^~a, 'g'^~b>),
                                  <'e3', $S>)
                         ) @ #vk.22 )
                    case S_3
                    solve( !KU( 'g'^~a ) @ #vk.24 )
                      case S_1
                      solve( !KU( 'g'^~b ) @ #vk.22 )
                        case BE_2
                        SOLVED // trace found
                      qed
                    qed
                  qed
                qed
              qed
            qed
          qed
        qed
      qed
    qed
  qed
qed

lemma key_secrecy_pfs_S:
  all-traces
  "∀ S BE K #i #j.
    ((SKey( S, BE, K ) @ #i) ∧ (K( K ) @ #j)) ⇒
    (∃ #r. (RevLtk( BE ) @ #r) ∧ (#r < #i))"
/*
guarded formula characterizing all counter-examples:
"∃ S BE K #i #j.
  (SKey( S, BE, K ) @ #i) ∧ (K( K ) @ #j)
 ∧
  ∀ #r. (RevLtk( BE ) @ #r) ⇒ ¬(#r < #i)"
*/
simplify
solve( S_wait1( $S, $BE, ~a ) ▶₀ #i )
  case S_1
  solve( !Pk( $BE, pk(x) ) ▶₂ #i )
    case Register_pk
    solve( !Ltk( $S, skS ) ▶₃ #i )
      case Register_pk
      solve( !KU( h(<'enrol', z, $S, $BE, 'g'^~a, Y>) ) @ #vk.11 )
        case c_h
        solve( !KU( sign(<'e2', $S, $BE, 'g'^~a, Y>, ~sk) ) @ #vk.13 )
          case BE_2
          solve( !KU( sign(<'e1', $S, $BE, 'g'^~a>, ~sk.3) ) @ #vk.25 )
            case S_1
            solve( !KU( 'g'^(~a*~b) ) @ #vk.22 )
              case BE_2
              by solve( !KU( ~a ) @ #vk.26 )
            next
              case S_1
              by solve( !KU( ~b ) @ #vk.26 )
            next
              case c_exp
              by solve( !KU( ~a ) @ #vk.28 )
            qed
          next
            case c_sign
            solve( !KU( ~sk.3 ) @ #vk.29 )
              case Reveal_ltk
              solve( !KU( 'g'^(~a*~b) ) @ #vk.27 )
                case BE_2
                by solve( !KU( ~a ) @ #vk.30 )
              next
                case S_1
                by solve( !KU( ~b ) @ #vk.30 )
              next
                case c_exp
                by solve( !KU( ~a ) @ #vk.32 )
              qed
            qed
          qed
        next
          case c_sign
          solve( !KU( ~sk ) @ #vk.21 )
            case Reveal_ltk
            by contradiction /* from formulas */
          qed
        qed
      qed
    qed
  qed
qed

